desc:416-Guitar - Three Electric Guitars with Chorus and Delay (Decent Sampler library) v1.0
// Electric guitars from the Decent Sampler library, played from sample maps:
//   62 Reissue Stratocaster (3 velocity layers), ASAT Clean and ASAT DI (3 round-robins each)
// plus a stereo CHORUS and a stereo / ping-pong DELAY (free time or tempo-synced).
// Run Install-Guitar.ps1 once to install the sample links and maps.
// Samples are read from  <REAPER resource path>/Data/Guitars/...  (folder links + map files).

options:maxmem=32000000

import RIControllers.jsfx-inc

slider1:0<0,2,1{62 Reissue Strat,ASAT Clean,ASAT DI}>-Guitar
slider2:0.4<0,1,0.01>-Chorus Mix
slider3:0.8<0.1,5,0.05>-Chorus Rate (Hz)
slider4:0.5<0,1,0.01>-Chorus Depth
slider5:0.25<0,1,0.01>-Delay Mix
slider6:380<20,1200,1>-Delay Time (ms)
slider7:0.35<0,0.9,0.01>-Delay Feedback
slider8:0<0,1,1>-Delay Tempo Sync
slider9:2<0,6,1>-Delay Sync Division
slider10:1<0,1,1>-Delay Ping-Pong
slider11:0.5<0,1,0.01>-Delay Tone
slider12:1<0,2,0.01>-Output Volume

in_pin:none
out_pin:left output
out_pin:right output

@init
rc_load();
// ---- rig remote (the window sends MIDI to the Tukan rig placed after this plugin) ----
rq = 2300; rqr = 0; rqw = 0; rn = 3100; fxnp = 3150; fxn = 3160; fxname = 3230; rkv = 3240;
rig_p = 0; rig_fx = 0; menu_ok = 0; memset(rkv, 0.5, 32);
rn[0] = "TWO OF US";
rn[1] = "WHAT THEY TOLD YOU";
rn[2] = "BASKET BALL";
rn[3] = "DANI C.";
rn[4] = "TAKE ME";
rn[5] = "BLOG: INTRO FUZZ";
rn[6] = "BLOG: WEIRDING";
rn[7] = "BLOG: HARD DRIVE";
rn[8] = "BLOG: SCOOPED MARSH";
rn[9] = "BLOG: IN YER FKN FACE";
rn[10] = "BLOG: VERY LOUD";
rn[11] = "RIDE SURFER";
rn[12] = "ABRAXAS";
rn[13] = "SANTA ANTMAN";
rn[14] = "ELF STEEMS";
rn[15] = "SOMETHING ROAD";
rn[16] = "OUTA SPACE";
rn[17] = "GANG A BONG";
rn[18] = "PURPLE PRECIPITATION";
rn[19] = "VOODOO";
rn[20] = "BLOG: STAY A WHILE AND LISTEN";
rn[21] = "BLOG: PUNKIFIER";
rn[22] = "BLOG: TEXTURED DRIVE";
rn[23] = "BLOG: BRUTAL IN PINK";
rn[24] = "BLOG: BEARD, PLAID SHIRT, TOO MANY PEDALS PROBABLY";
rn[25] = "INIT AMP 1";
rn[26] = "INIT AMP 2";
rn[27] = "INIT AMP 3";
rn[28] = "INIT AMP 4";
rn[29] = "CLEAN";
rn[30] = "CLEAN + CHORUS";
rn[31] = "CRUNCH";
rn[32] = "ROCK";
rn[33] = "LEAD + DELAY";
rn[34] = "HIGH GAIN";
rn[35] = "BLUES";
rn[36] = "AMBIENT";
fxname[0] = "AMP"; fxname[1] = "DIST"; fxname[2] = "CHORUS"; fxname[3] = "FLANGER"; fxname[4] = "PHASER"; fxname[5] = "TREMOLO"; fxname[6] = "DELAY"; fxname[7] = "REVERB";
fxnp[0] = 4; fxnp[1] = 4; fxnp[2] = 2; fxnp[3] = 4; fxnp[4] = 4; fxnp[5] = 4; fxnp[6] = 3; fxnp[7] = 1;
fxn[0] = "GAIN"; fxn[1] = "BASS"; fxn[2] = "MID"; fxn[3] = "TREBLE";
fxn[4] = "DRIVE"; fxn[5] = "LOWPASS"; fxn[6] = "OUTPUT"; fxn[7] = "DIST LEVEL";
fxn[8] = "DEPTH"; fxn[9] = "BALANCE";
fxn[12] = "RATE"; fxn[13] = "DELAY"; fxn[14] = "DEPTH"; fxn[15] = "PHASE";
fxn[16] = "RATE"; fxn[17] = "FEEDBACK"; fxn[18] = "MIX"; fxn[19] = "RANGE";
fxn[20] = "RATE"; fxn[21] = "AMOUNT"; fxn[22] = "STEREO"; fxn[23] = "SHAPE";
fxn[24] = "TIME"; fxn[25] = "FEEDBACK"; fxn[26] = "MIX";
fxn[28] = "AMOUNT";
NV = 64;          // voices
MAXS = 96;        // max samples per guitar

// voice tables
vact = 0; vgate = NV; vhold = NV*2; venv = NV*3; vpos = NV*4; vrate = NV*5;
vbase = NV*6; vlen = NV*7; vnch = NV*8; vnote = NV*9; vgain = NV*10;

// text / UI tables
pkey = 800; pname = 810; psub = 820;
PP = 790;
ctl = 900; NC = 9;
keys = 1000;      // 128 slots: velocity of the key currently down (for the keyboard display)
cand = 1150;      // up to 16 round-robin / layer candidates for the current note
divb = 1170;      // delay sync divisions in beats
divn = 1180;      // delay sync division names

// sample tables (one entry per loaded sample)
sroot = 1200; slo = sroot + MAXS; shi = slo + MAXS; slv = shi + MAXS; shv = slv + MAXS;
sbase = shv + MAXS; slen = sbase + MAXS; snch = slen + MAXS; sfs = snch + MAXS;
sgain = sfs + MAXS; stune = sgain + MAXS;      // ends around 2200

SCR = 4096;               // scratch (4096 slots) used to skip sample start offsets
FXM = 8192;               // chorus + delay buffers
ARENA = 1300000;          // sample memory
ARENASZ = 30000000;

pkey[0] = "Strat62"; pkey[1] = "AsatClean"; pkey[2] = "AsatDI";
pname[0] = "62 REISSUE STRAT"; pname[1] = "ASAT CLEAN"; pname[2] = "ASAT DI";
psub[0] = "Stratocaster - 3 velocity layers";
psub[1] = "Tele-style clean - 3 round-robins";
psub[2] = "Tele-style DI - 3 round-robins";

divb[0] = 0.25; divb[1] = 1/3; divb[2] = 0.5; divb[3] = 0.75; divb[4] = 1; divb[5] = 1.5; divb[6] = 2;
divn[0] = "1/16"; divn[1] = "1/8T"; divn[2] = "1/8"; divn[3] = "1/8."; divn[4] = "1/4"; divn[5] = "1/4."; divn[6] = "1/2";

// clickable bars: x, y, w, h, min, max, slider#, step, default
// chorus
co = ctl;      co[0] = 35;  co[1] = 244; co[2] = 235; co[3] = 24; co[4] = 0;   co[5] = 1; co[6] = 2;  co[7] = 0.01; co[8] = 0.4;
co = ctl + 9;  co[0] = 35;  co[1] = 294; co[2] = 235; co[3] = 24; co[4] = 0.1; co[5] = 5; co[6] = 3;  co[7] = 0.05; co[8] = 0.8;
co = ctl + 18; co[0] = 35;  co[1] = 344; co[2] = 235; co[3] = 24; co[4] = 0;   co[5] = 1; co[6] = 4;  co[7] = 0.01; co[8] = 0.5;
// delay
co = ctl + 27; co[0] = 315; co[1] = 244; co[2] = 170; co[3] = 24; co[4] = 0;   co[5] = 1;    co[6] = 5;  co[7] = 0.01; co[8] = 0.25;
co = ctl + 36; co[0] = 315; co[1] = 294; co[2] = 170; co[3] = 24; co[4] = 20;  co[5] = 1200; co[6] = 6;  co[7] = 1;    co[8] = 380;
co = ctl + 45; co[0] = 315; co[1] = 344; co[2] = 170; co[3] = 24; co[4] = 0;   co[5] = 0.9;  co[6] = 7;  co[7] = 0.01; co[8] = 0.35;
co = ctl + 54; co[0] = 500; co[1] = 244; co[2] = 170; co[3] = 24; co[4] = 0;   co[5] = 1;    co[6] = 11; co[7] = 0.01; co[8] = 0.5;
// output
co = ctl + 63; co[0] = 705; co[1] = 244; co[2] = 160; co[3] = 24; co[4] = 0;   co[5] = 2;    co[6] = 12; co[7] = 0.01; co[8] = 1;
// delay time bar doubles as the division picker when tempo sync is on (entry 7 is unused slot, kept for layout symmetry)
co = ctl + 72; co[0] = 500; co[1] = 294; co[2] = 0;   co[3] = 0;  co[4] = 0;   co[5] = 1; co[6] = 1;  co[7] = 1;    co[8] = 0;
gdrag = -1; glmd = 0;

// --- effect buffers ---
chlen = floor(0.04 * srate) + 4;
dlen  = floor(2.6 * srate);
cbL = FXM; cbR = cbL + chlen; dbL = cbR + chlen; dbR = dbL + dlen;
memset(cbL, 0, chlen * 2);
memset(dbL, 0, dlen * 2);
cw = 0; dw = 0; cph = 0;
dtc = 0.38 * srate;
fbLf = 0; fbRf = 0;

// --- voices / state ---
memset(keys, 0, 128);
i = 0;
loop(NV, vact[i] = 0; vgate[i] = 0; vhold[i] = 0; venv[i] = 0; i += 1; );
loaded = -1;
ns = 0;
guitar_norm = 1;
rr = 0; rrc = 0;
sustain = 0;
lastvel = 0; lastlv = 0; lasthv = 0; lastnote = -1;
atk_inc = 1 / (0.002 * srate);
rel_mul = exp(-1 / (0.25 * srate));
pkm = 0;

// parse the next number (digits, '-', '.') out of a string, starting at PP[0]
function nextnum(str, pos)
  local(p, n, c, neg, v, scale)
(
  p = pos[0]; n = strlen(str);
  while (p < n && (c = str_getchar(str, p)) != 45 && (c < 48 || c > 57) && c != 46) ( p += 1; );
  neg = 0;
  (p < n && str_getchar(str, p) == 45) ? ( neg = 1; p += 1; );
  v = 0;
  while (p < n && (c = str_getchar(str, p)) >= 48 && c <= 57) ( v = v * 10 + (c - 48); p += 1; );
  (p < n && str_getchar(str, p) == 46) ? (
    p += 1; scale = 0.1;
    while (p < n && (c = str_getchar(str, p)) >= 48 && c <= 57) ( v += (c - 48) * scale; scale *= 0.1; p += 1; );
  );
  pos[0] = p;
  neg ? -v : v;
);

function tanhx(x)
  local(y, e)
(
  y = max(-8, min(8, x));
  e = exp(2 * y);
  (e - 1) / (e + 1);
);

@slider
// (re)load the sample set when the guitar changes
slider1 != loaded ? (
  loaded = slider1;
  ld_i = 0; loop(NV, vact[ld_i] = 0; ld_i += 1; );
  memset(keys, 0, 128);
  ns = 0;
  ptr = ARENA;
  norm_peak = 0.000001;

  sprintf(#ld_m, "Guitars/%s_map.txt", pkey[loaded]);
  sprintf(#ld_f, "Guitars/%s_files.txt", pkey[loaded]);
  mh = file_open(#ld_m);
  fh = file_open(#ld_f);

  (mh > 0 && fh > 0) ? (
    file_string(mh, #ld_l);
    PP[0] = 0;
    ld_cnt = nextnum(#ld_l, PP);
    ld_k = 0;
    while (ld_k < ld_cnt && ld_k < MAXS) (
      // one line of numbers: root lo hi loVel hiVel start len gainDb tune mono
      file_string(mh, #ld_l);
      PP[0] = 0;
      ld_root = nextnum(#ld_l, PP); ld_lo = nextnum(#ld_l, PP); ld_hi = nextnum(#ld_l, PP);
      ld_lv = nextnum(#ld_l, PP);   ld_hv = nextnum(#ld_l, PP); ld_start = nextnum(#ld_l, PP);
      ld_len = nextnum(#ld_l, PP);  ld_gdb = nextnum(#ld_l, PP); ld_tune = nextnum(#ld_l, PP);
      ld_mono = nextnum(#ld_l, PP);

      // one line with the sample path (strip any trailing line-break characters)
      file_string(fh, #ld_p);
      ld_n = strlen(#ld_p);
      while (ld_n > 0 && str_getchar(#ld_p, ld_n - 1) <= 32) ( ld_n -= 1; );
      strcpy_substr(#ld_t, #ld_p, 0, ld_n);
      strcpy(#ld_p, #ld_t);

      sh = file_open(#ld_p);
      sh > 0 ? (
        ld_nch = 0; ld_fsr = 0;
        file_riff(sh, ld_nch, ld_fsr);
        ld_nch > 0 ? (
          // skip the silent lead-in
          ld_sk = ld_start * ld_nch;
          while (ld_sk > 0) (
            ld_n = min(ld_sk, 4096);
            file_mem(sh, SCR, ld_n);
            ld_sk -= ld_n;
          );
          ld_fr = min(ld_len, floor(file_avail(sh) / ld_nch));
          ld_fold = (ld_mono > 0.5 && ld_nch == 2);
          ld_outch = ld_fold ? 1 : ld_nch;
          ld_items = ld_fr * ld_outch;
          (ld_fr > 1000 && ptr + ld_items <= ARENA + ARENASZ) ? (
            ld_fold ? (
              ld_done = 0;
              while (ld_done < ld_fr) (
                ld_c = min(2048, ld_fr - ld_done);
                file_mem(sh, SCR, ld_c * 2);
                ld_j = 0;
                loop(ld_c, ptr[ld_done + ld_j] = (SCR[ld_j * 2] + SCR[ld_j * 2 + 1]) * 0.5; ld_j += 1; );
                ld_done += ld_c;
              );
            ) : (
              file_mem(sh, ptr, ld_items);
            );

            ld_pk = 0; ld_j = 0;
            loop(floor(ld_items / 2), ld_pk = max(ld_pk, abs(ptr[ld_j])); ld_j += 2; );

            sroot[ns] = ld_root; slo[ns] = ld_lo; shi[ns] = ld_hi;
            slv[ns] = ld_lv;     shv[ns] = ld_hv;
            sbase[ns] = ptr;     slen[ns] = ld_fr;
            snch[ns] = ld_outch; sfs[ns] = ld_fsr;
            sgain[ns] = 10 ^ (ld_gdb / 20);
            stune[ns] = ld_tune;
            norm_peak = max(norm_peak, ld_pk * sgain[ns]);
            ptr += ld_items;
            ns += 1;
          );
        );
        file_close(sh);
      );
      ld_k += 1;
    );
  );
  mh > 0 ? file_close(mh);
  fh > 0 ? file_close(fh);
  guitar_norm = 0.8 / norm_peak;
);

@block
while (rqr != rqw) ( midisend(0, rq[rqr * 3], rq[rqr * 3 + 1], rq[rqr * 3 + 2]); rqr = (rqr + 1) & 255; );
while (midirecv(offs, m1, m2, m3)) (
  st = m1 & 0xF0;
  (st == 0xB0 || st == 0xC0) ? midisend(offs, m1, m2, m3);   // pass controller messages on to a rig after this instrument (knobs 1-4 belong to the rig)
  rct = rc_decode(m1, m2, m3);
  (st == 0x90 || st == 0x80) && (m1 & 15) == rc_padch - 1 ? ( st = 0; );   // drum-pad channel does not play this instrument
  rct == 1 ? (
    rc_idx == 0 ? ( slider12 = 0 + rc_val * (2 - 0); sliderchange(2^11); ) :
    0;
  ) : rct == 2 ? (
    rc_idx == 4 ? ( slider2 = 0 + rc_val * (1 - 0); sliderchange(2^1); ) :
    rc_idx == 5 ? ( slider5 = 0 + rc_val * (1 - 0); sliderchange(2^4); ) :
    rc_idx == 6 ? ( slider6 = 20 + rc_val * (1200 - 20); sliderchange(2^5); ) :
    rc_idx == 7 ? ( slider7 = 0 + rc_val * (0.9 - 0); sliderchange(2^6); ) :
    0;
  ) : (rct == 4 || rct == 5 || rct == 6) ? (
    slider1 = (slider1 + rc_idx + 3) % 3; sliderchange(2^0);
  ) :

  (st == 0x90 && m3 > 0) ? (
    keys[m2] = m3;

    // collect every sample that matches the note and velocity (round-robins / layers), then rotate through them
    nc = 0;
    i = 0;
    loop(ns,
      (m2 >= slo[i] && m2 <= shi[i] && m3 >= slv[i] && m3 <= shv[i]) ? (
        nc < 16 ? ( cand[nc] = i; nc += 1; );
      );
      i += 1;
    );
    bk = (nc > 0) ? cand[rrc % nc] : -1;
    rrc += 1;

    bk >= 0 ? (
      v = -1;
      i = 0;
      while (i < NV && v < 0) ( vact[i] == 0 ? v = i; i += 1; );
      v < 0 ? ( v = rr; rr = (rr + 1) % NV; );

      vbase[v] = sbase[bk];
      vlen[v]  = slen[bk];
      vnch[v]  = snch[bk];
      vrate[v] = 2 ^ ((m2 - sroot[bk] + stune[bk]) / 12) * sfs[bk] / srate;
      vgain[v] = sgain[bk] * guitar_norm * (0.55 + 0.45 * m3 / 127);
      vpos[v]  = 0;
      venv[v]  = 0;
      vnote[v] = m2;
      vact[v]  = 1;
      vgate[v] = 1;
      vhold[v] = 0;

      lastvel = m3; lastlv = slv[bk]; lasthv = shv[bk]; lastnote = m2;
    );
  ) : (st == 0x80 || (st == 0x90 && m3 == 0)) ? (
    keys[m2] = 0;
    i = 0;
    loop(NV,
      (vact[i] && vgate[i] && vnote[i] == m2) ? (
        sustain ? vhold[i] = 1 : vgate[i] = 0;
      );
      i += 1;
    );
  ) : (st == 0xB0 && m2 == 64) ? (
    sustain = (m3 >= 64);
    !sustain ? (
      i = 0;
      loop(NV, vhold[i] ? ( vhold[i] = 0; vgate[i] = 0; ); i += 1; );
    );
  ) : (st == 0xB0 && (m2 == 123 || m2 == 120)) ? (
    i = 0;
    loop(NV, vgate[i] = 0; vhold[i] = 0; i += 1; );
    memset(keys, 0, 128);
  );
);

@sample
l = r = 0;
i = 0;
loop(NV,
  vact[i] ? (
    vgate[i] ? (
      venv[i] < 1 ? venv[i] = min(1, venv[i] + atk_inc);
    ) : (
      venv[i] *= rel_mul;
      venv[i] < 0.0005 ? ( venv[i] = 0; vact[i] = 0; );
    );

    pos = vpos[i];
    ip  = floor(pos);
    fr  = pos - ip;
    nc2 = vnch[i];
    bb  = vbase[i] + ip * nc2;

    sleft = bb[0] + (bb[nc2] - bb[0]) * fr;
    sright = (nc2 == 2) ? (bb[1] + (bb[nc2 + 1] - bb[1]) * fr) : sleft;

    g = vgain[i] * venv[i];
    rem = vlen[i] - pos;
    rem < 19200 ? g *= rem / 19200;        // fade out where the sample was cut

    l += sleft * g;
    r += sright * g;

    vpos[i] = pos + vrate[i];
    vpos[i] >= vlen[i] - 2 ? vact[i] = 0;
  );
  i += 1;
);

// ---------------- chorus: two modulated taps per channel ----------------
cph += slider3 / srate; cph >= 1 ? cph -= 1;
cbase_s = 0.012 * srate;
cdep_s = (0.001 + slider4 * 0.007) * srate;

cwp = cw;
cbL[cwp] = l; cbR[cwp] = r;

ct = cbase_s + cdep_s * sin(2 * $pi * cph);
crd = cwp - ct; crd < 0 ? crd += chlen; ci0 = floor(crd); cf = crd - ci0; ci1 = ci0 + 1; ci1 >= chlen ? ci1 -= chlen;
cL1 = cbL[ci0] + (cbL[ci1] - cbL[ci0]) * cf;

ct = cbase_s + cdep_s * sin(2 * $pi * (cph + 0.33));
crd = cwp - ct; crd < 0 ? crd += chlen; ci0 = floor(crd); cf = crd - ci0; ci1 = ci0 + 1; ci1 >= chlen ? ci1 -= chlen;
cL2 = cbL[ci0] + (cbL[ci1] - cbL[ci0]) * cf;

ct = cbase_s + cdep_s * sin(2 * $pi * (cph + 0.5));
crd = cwp - ct; crd < 0 ? crd += chlen; ci0 = floor(crd); cf = crd - ci0; ci1 = ci0 + 1; ci1 >= chlen ? ci1 -= chlen;
cR1 = cbR[ci0] + (cbR[ci1] - cbR[ci0]) * cf;

ct = cbase_s + cdep_s * sin(2 * $pi * (cph + 0.83));
crd = cwp - ct; crd < 0 ? crd += chlen; ci0 = floor(crd); cf = crd - ci0; ci1 = ci0 + 1; ci1 >= chlen ? ci1 -= chlen;
cR2 = cbR[ci0] + (cbR[ci1] - cbR[ci0]) * cf;

cw += 1; cw >= chlen ? cw = 0;

l = l * (1 - 0.35 * slider2) + (cL1 + cL2) * 0.5 * slider2 * 0.8;
r = r * (1 - 0.35 * slider2) + (cR1 + cR2) * 0.5 * slider2 * 0.8;

// ---------------- delay: stereo or ping-pong, free time or tempo sync ----------------
dtarget = slider8 > 0.5 ? (60 / max(20, tempo)) * divb[slider9] * srate : slider6 * 0.001 * srate;
dtarget = max(8, min(dlen - 4, dtarget));
dtc += (dtarget - dtc) * 0.0008;

drd = dw - dtc; drd < 0 ? drd += dlen;
di0 = floor(drd); df = drd - di0; di1 = di0 + 1; di1 >= dlen ? di1 -= dlen;
dL = dbL[di0] + (dbL[di1] - dbL[di0]) * df;
dR = dbR[di0] + (dbR[di1] - dbR[di0]) * df;

dlp = 0.12 + 0.85 * slider11;          // tone: darker repeats at low values
fbLf += (dL - fbLf) * dlp;
fbRf += (dR - fbRf) * dlp;

slider10 > 0.5 ? (
  // ping-pong: the dry signal enters the left line, repeats bounce left -> right -> left
  dbL[dw] = (l + r) * 0.5 + fbRf * slider7;
  dbR[dw] = fbLf * slider7;
) : (
  dbL[dw] = l + fbLf * slider7;
  dbR[dw] = r + fbRf * slider7;
);
dw += 1; dw >= dlen ? dw = 0;

outL = tanhx(l + dL * slider5) * slider12;
outR = tanhx(r + dR * slider5) * slider12;
spl0 = outL;
spl1 = outR;
pkm = max(pkm * 0.9998, max(abs(outL), abs(outR)));

@gfx 1000 620
// Look after the Jexed and JamSynth panels (chmaha JSFX ports): dark panels, preset LCD with arrows, round knobs with a coloured arc.
// The RIG panel remote-controls the Tukan Guitar Station S2 placed after this plugin in the same FX chain (MIDI messages): all
// its presets (Program Change), the effect choice and the four knobs of the chosen effect. All drawing code here is new.
gfx_clear = 0x181614;

function gt_set(gs, v) ( slider(gs) = v; sliderchange(2 ^ (gs - 1)); slider_automate(2 ^ (gs - 1)); );
function rig_send(a, b, c) ( rq[rqw * 3] = a; rq[rqw * 3 + 1] = b; rq[rqw * 3 + 2] = c; rqw = (rqw + 1) & 255; );
function rig_preset(p) ( rig_p = (p + 37) % 37; rig_send(192, rig_p, 0); menu_ok = 0; memset(rkv, 0.5, 32); );
function rig_fxsel(e) ( rig_fx = e; rig_send(176, rc_f4, floor((e + 0.5) / 8 * 127)); );
function rig_knob(j, v) ( rkv[rig_fx * 4 + j] = v; rig_send(176, j == 0 ? rc_k1 : (j == 1 ? rc_k2 : (j == 2 ? rc_k3 : rc_k4)), floor(v * 127 + 0.5)); );

// sampler knob table
function kn(k) (
  k == 0 ? ( ks = 2;  klo = 0;   khi = 1;    kst = 0.01; kdf = 0.4;  kc = 0; ) :
  k == 1 ? ( ks = 3;  klo = 0.1; khi = 5;    kst = 0.05; kdf = 0.8;  kc = 0; ) :
  k == 2 ? ( ks = 4;  klo = 0;   khi = 1;    kst = 0.01; kdf = 0.5;  kc = 0; ) :
  k == 3 ? ( ks = 5;  klo = 0;   khi = 1;    kst = 0.01; kdf = 0.25; kc = 1; ) :
  k == 4 ? ( ks = 6;  klo = 20;  khi = 1200; kst = 1;    kdf = 380;  kc = 1; ) :
  k == 5 ? ( ks = 7;  klo = 0;   khi = 0.9;  kst = 0.01; kdf = 0.35; kc = 1; ) :
  k == 6 ? ( ks = 11; klo = 0;   khi = 1;    kst = 0.01; kdf = 0.5;  kc = 1; ) :
           ( ks = 12; klo = 0;   khi = 2;    kst = 0.01; kdf = 1;    kc = 2; );
  kx = 420 + k * 72; ky = 196;
  kc == 0 ? ( pr = 0.68; pg = 0.48; pb = 0.92; ) : kc == 1 ? ( pr = 0.45; pg = 0.60; pb = 0.98; ) : ( pr = 0.92; pg = 0.92; pb = 0.92; );
);

function drawknob(cx, cy, frac, from) local(rad, rf) (
  rad = (frac * 260 - 130) * $pi / 180; rf = (from * 260 - 130) * $pi / 180;
  gfx_set(0.16, 0.17, 0.19, 1);
  gr_ = 23; loop(5, gfx_arc(cx, cy, gr_, -130 * $pi / 180, 130 * $pi / 180, 1); gr_ -= 0.5; );
  gfx_set(pr, pg, pb, 1);
  gr_ = 23; loop(5, gfx_arc(cx, cy, gr_, min(rf, rad), max(rf, rad), 1); gr_ -= 0.5; );
  gfx_set(0.07, 0.075, 0.085, 1); gfx_circle(cx, cy, 18, 1, 1);
  gfx_set(0.2, 0.21, 0.24, 1); gfx_circle(cx, cy, 15, 1, 1);
  gfx_set(0.96, 0.96, 0.96, 1);
  gfx_line(cx + sin(rad) * 5, cy - cos(rad) * 5, cx + sin(rad) * 13, cy - cos(rad) * 13, 1);
);

// ---- rig preset menu ----
!menu_ok ? (
  menu_ok = 1; strcpy(#pm, ">TUKAN PRESETS|");
  gp = 0;
  loop(37,
    gp == 29 ? strcat(#pm, "<|>REAPER INSTRUMENTS PRESETS|");
    gp == rig_p ? strcat(#pm, "!");
    strcat(#pm, rn[gp]); strcat(#pm, "|");
    gp += 1;
  );
  strcat(#pm, "<");
);

// ====================== mouse ======================
gmd = mouse_cap & 1;
gmd && !glmd ? (
  gdrag = -1;
  (mouse_y >= 14 && mouse_y < 92) ? (
    (mouse_x >= 270 && mouse_x < 302) ? rig_preset(rig_p - 1) :
    (mouse_x >= 638 && mouse_x < 670) ? rig_preset(rig_p + 1) :
    (mouse_x >= 302 && mouse_x < 638) ? (
      gfx_x = mouse_x; gfx_y = mouse_y; gsel = gfx_showmenu(#pm);
      gsel > 0 ? rig_preset(gsel - 1); menu_ok = 0;
    );
  );
  // guitar cells
  gt = 0;
  loop(3,
    (mouse_x >= 24 && mouse_x < 364 && mouse_y >= 138 + gt * 56 && mouse_y < 138 + gt * 56 + 50) ? gt_set(1, gt);
    gt += 1;
  );
  // sampler knobs
  gk = 0;
  loop(8,
    kn(gk);
    (mouse_x >= kx - 28 && mouse_x < kx + 28 && mouse_y >= ky - 28 && mouse_y < ky + 24) ? (
      gnow = time_precise();
      ((mouse_cap & 4) || (gk == glast_k && gnow - glast_t < 0.45)) ? ( gt_set(ks, kdf); ) :
      ( gdrag = gk; gdy0 = mouse_y; gdv0 = slider(ks); );
      glast_k = gk; glast_t = gnow;
    );
    gk += 1;
  );
  // toggles: tempo sync, ping-pong, division
  (mouse_y >= 252 && mouse_y < 278) ? (
    (mouse_x >= 400 && mouse_x < 480) ? gt_set(8, 1 - slider8);
    (mouse_x >= 490 && mouse_x < 590) ? gt_set(10, 1 - slider10);
    (mouse_x >= 600 && mouse_x < 680) ? gt_set(9, (slider9 + 1) % 7);
  );
  // rig: effect cells and knobs
  (mouse_x >= 24 && mouse_x < 424 && mouse_y >= 352 && mouse_y < 448) ? (
    ge = floor((mouse_y - 352) / 48) * 4 + floor((mouse_x - 24) / 100);
    ge >= 0 && ge < 8 ? rig_fxsel(ge);
  );
  gj = 0;
  loop(4,
    gj < fxnp[rig_fx] ? (
      gkx = 520 + gj * 110; gky = 416;
      (mouse_x >= gkx - 28 && mouse_x < gkx + 28 && mouse_y >= gky - 28 && mouse_y < gky + 24) ? (
        gnow = time_precise();
        ((mouse_cap & 4) || (gnow - glast_t < 0.45 && glast_k == 100 + gj)) ? rig_knob(gj, 0.5) :
        ( gdrag = 100 + gj; gdy0 = mouse_y; gdv0 = rkv[rig_fx * 4 + gj]; );
        glast_k = 100 + gj; glast_t = gnow;
      );
    );
    gj += 1;
  );
);
gmd && gdrag >= 0 && gdrag < 100 ? (
  kn(gdrag);
  gv = gdv0 + (gdy0 - mouse_y) / (mouse_cap & 8 ? 600 : 160) * (khi - klo);
  gv = max(klo, min(khi, gv)); gv = floor(gv / kst + 0.5) * kst;
  gv != slider(ks) ? gt_set(ks, gv);
);
gmd && gdrag >= 100 ? (
  gv = gdv0 + (gdy0 - mouse_y) / (mouse_cap & 8 ? 600 : 160);
  gv = max(0, min(1, gv));
  abs(gv - rkv[rig_fx * 4 + gdrag - 100]) > 0.004 ? rig_knob(gdrag - 100, gv);
);
mouse_wheel != 0 ? (
  gk = 0;
  loop(8,
    kn(gk);
    (mouse_x >= kx - 28 && mouse_x < kx + 28 && mouse_y >= ky - 28 && mouse_y < ky + 24) ? (
      gv = slider(ks) + (mouse_wheel > 0 ? 1 : -1) * max(kst, (khi - klo) * 0.04);
      gv = max(klo, min(khi, gv)); gv = floor(gv / kst + 0.5) * kst; gt_set(ks, gv);
    );
    gk += 1;
  );
  gj = 0;
  loop(4,
    gj < fxnp[rig_fx] ? (
      (mouse_x >= 492 + gj * 110 && mouse_x < 548 + gj * 110 && mouse_y >= 388 && mouse_y < 440) ? (
        rig_knob(gj, max(0, min(1, rkv[rig_fx * 4 + gj] + (mouse_wheel > 0 ? 0.04 : -0.04))));
      );
    );
    gj += 1;
  );
  mouse_wheel = 0;
);
!gmd ? gdrag = -1;
glmd = gmd;

// ====================== header ======================
gfx_setfont(1, "Arial", 30, 98);
gfx_set(0.95, 0.62, 0.18, 1); gfx_x = 20; gfx_y = 14; gfx_drawstr("GUITAR");
gfx_setfont(1, "Arial", 12);
gfx_set(0.6, 0.6, 0.62, 1); gfx_x = 22; gfx_y = 54; gfx_drawstr("sampled guitars + Tukan amps and effects");
gfx_x = 22; gfx_y = 70; gfx_drawstr("the display browses the rig presets");

gfx_set(0.055, 0.04, 0.025, 1); gfx_rect(270, 14, 400, 78);
gfx_set(0.25, 0.2, 0.12, 1); gfx_rect(270, 14, 400, 78, 0);
gfx_set(0.16, 0.17, 0.19, 1); gfx_rect(270, 14, 32, 78); gfx_rect(638, 14, 32, 78);
gfx_set(0.95, 0.5, 0.2, 1);
gfx_triangle(292, 38, 292, 68, 278, 53);
gfx_triangle(648, 38, 648, 68, 662, 53);
gfx_setfont(1, "Courier New", 13, 98);
gfx_set(0.95, 0.6, 0.2, 1);
gfx_x = 314; gfx_y = 22; rig_p < 29 ? gfx_drawstr("TUKAN RIG") : gfx_drawstr("REAPER INSTRUMENTS RIG");
sprintf(#gs, "%03d/037", rig_p + 1);
gfx_measurestr(#gs, gw_, gh_); gfx_x = 628 - gw_; gfx_y = 22; gfx_drawstr(#gs);
gfx_setfont(1, "Courier New", 22, 98);
gfx_set(1, 0.72, 0.25, 1);
gfx_measurestr(rn[rig_p], gw_, gh_); gfx_x = 470 - gw_ / 2; gfx_y = 46; gfx_drawstr(rn[rig_p]);

gfx_set(0.1, 0.11, 0.12, 1); gfx_rect(880, 96, 100, 6);
gfx_set(0.36, 0.82, 0.5, 1); gfx_rect(880, 96, min(1, pkm) * 100, 6);

// ====================== guitar panel ======================
gfx_set(0.098, 0.106, 0.118, 1); gfx_rect(12, 108, 372, 204);
gfx_set(0.16, 0.17, 0.19, 1); gfx_rect(12, 108, 372, 204, 0);
gfx_set(0.96, 0.62, 0.18, 1); gfx_rect(12, 108, 372, 2);
gfx_setfont(1, "Arial", 12, 98); gfx_x = 20; gfx_y = 116; gfx_drawstr("GUITAR");
gt = 0;
loop(3,
  gcy = 138 + gt * 56;
  gsel = (slider1 == gt);
  ghov = (mouse_x >= 24 && mouse_x < 364 && mouse_y >= gcy && mouse_y < gcy + 50);
  gsel ? ( gfx_set(0.55, 0.33, 0.08, 1); gfx_rect(24, gcy, 340, 50); gfx_set(0.7, 0.42, 0.1, 1); gfx_rect(24, gcy + 25, 340, 25); ) :
         ( gfx_set(ghov ? 0.13 : 0.09, ghov ? 0.14 : 0.1, ghov ? 0.16 : 0.115, 1); gfx_rect(24, gcy, 340, 50); );
  gfx_setfont(1, "Arial", 11); gfx_set(gsel ? 1 : 0.8, gsel ? 0.8 : 0.5, 0.2, 1);
  sprintf(#gs, "%02d", gt + 1); gfx_x = 34; gfx_y = gcy + 6; gfx_drawstr(#gs);
  gfx_setfont(1, "Courier New", 16, 98); gfx_set(1, 1, 1, 1); gfx_x = 34; gfx_y = gcy + 18; gfx_drawstr(pname[gt]);
  gfx_setfont(1, "Arial", 11); gfx_set(gsel ? 1 : 0.55, gsel ? 0.9 : 0.55, gsel ? 0.7 : 0.58, 1);
  gfx_x = 34; gfx_y = gcy + 36; gsel ? sprintf(#gs, "%s  -  %d samples", psub[gt], ns) : sprintf(#gs, "%s", psub[gt]);
  gfx_drawstr(#gs);
  gt += 1;
);

// ====================== chorus / delay / output ======================
gfx_set(0.098, 0.106, 0.118, 1); gfx_rect(396, 108, 592, 204);
gfx_set(0.16, 0.17, 0.19, 1); gfx_rect(396, 108, 592, 204, 0);
gfx_set(0.68, 0.48, 0.92, 1); gfx_rect(396, 108, 220, 2);
gfx_set(0.45, 0.60, 0.98, 1); gfx_rect(616, 108, 292, 2);
gfx_set(0.92, 0.92, 0.92, 1); gfx_rect(908, 108, 80, 2);
gfx_setfont(1, "Arial", 12, 98);
gfx_set(0.68, 0.48, 0.92, 1); gfx_x = 404; gfx_y = 116; gfx_drawstr("CHORUS");
gfx_set(0.45, 0.60, 0.98, 1); gfx_x = 624; gfx_y = 116; gfx_drawstr("DELAY");
gfx_set(0.92, 0.92, 0.92, 1); gfx_x = 916; gfx_y = 116; gfx_drawstr("OUTPUT");
gk = 0;
loop(8,
  kn(gk); gv = slider(ks);
  gk == 0 ? ( gnm = "MIX"; sprintf(#gs, "%d%%", floor(gv * 100 + 0.5)); ) :
  gk == 1 ? ( gnm = "RATE"; sprintf(#gs, "%.2f Hz", gv); ) :
  gk == 2 ? ( gnm = "DEPTH"; sprintf(#gs, "%d%%", floor(gv * 100 + 0.5)); ) :
  gk == 3 ? ( gnm = "MIX"; sprintf(#gs, "%d%%", floor(gv * 100 + 0.5)); ) :
  gk == 4 ? ( gnm = "TIME"; slider8 > 0.5 ? sprintf(#gs, "%s", divn[slider9]) : sprintf(#gs, "%d ms", gv); ) :
  gk == 5 ? ( gnm = "FEEDBACK"; sprintf(#gs, "%d%%", floor(gv / 0.9 * 100 + 0.5)); ) :
  gk == 6 ? ( gnm = "TONE"; sprintf(#gs, "%d%%", floor(gv * 100 + 0.5)); ) :
            ( gnm = "VOLUME"; sprintf(#gs, "%d%%", floor(gv * 100 + 0.5)); );
  gfx_setfont(1, "Arial", 11);
  gfx_set(0.85, 0.85, 0.85, 1); gfx_measurestr(#gs, gw_, gh_); gfx_x = kx - gw_ / 2; gfx_y = ky - 40; gfx_drawstr(#gs);
  gfx_set(0.62, 0.62, 0.66, 1); gfx_measurestr(gnm, gw_, gh_); gfx_x = kx - gw_ / 2; gfx_y = ky + 26; gfx_drawstr(gnm);
  drawknob(kx, ky, (gv - klo) / (khi - klo), 0);
  gk += 1;
);
// toggle pills
gt = 0;
loop(3,
  gbx = gt == 0 ? 400 : (gt == 1 ? 490 : 600); gbw = gt == 1 ? 100 : 80;
  gon = gt == 0 ? slider8 > 0.5 : (gt == 1 ? slider10 > 0.5 : 0);
  gon ? ( gfx_set(0.45, 0.60, 0.98, 1); gfx_rect(gbx, 252, gbw, 26); gfx_set(0.06, 0.07, 0.09, 1); ) :
        ( gfx_set(0.157, 0.176, 0.196, 1); gfx_rect(gbx, 252, gbw, 26); gfx_set(0.75, 0.75, 0.78, 1); );
  gfx_setfont(1, "Arial", 12, 98); gfx_x = gbx + 10; gfx_y = 258;
  gt == 0 ? gfx_drawstr("TEMPO SYNC") : (gt == 1 ? gfx_drawstr("PING-PONG") : ( sprintf(#gs, "DIV %s", divn[slider9]); gfx_drawstr(#gs); ));
  gt += 1;
);

// ====================== rig panel ======================
gfx_set(0.098, 0.106, 0.118, 1); gfx_rect(12, 322, 976, 150);
gfx_set(0.16, 0.17, 0.19, 1); gfx_rect(12, 322, 976, 150, 0);
gfx_set(0.95, 0.38, 0.50, 1); gfx_rect(12, 322, 976, 2);
gfx_setfont(1, "Arial", 12, 98); gfx_x = 20; gfx_y = 330;
gfx_drawstr("RIG  -  TUKAN GUITAR STATION S2  (put it after this plugin in the FX chain: the samples are its guitar input)");
gt = 0;
loop(8,
  gbx = 24 + (gt % 4) * 100; gby = 352 + floor(gt / 4) * 48;
  gsel = (rig_fx == gt);
  gsel ? ( gfx_set(0.55, 0.20, 0.28, 1); gfx_rect(gbx, gby, 94, 42); gfx_set(0.95, 0.38, 0.50, 1); gfx_rect(gbx, gby, 94, 2); ) :
         ( gfx_set(0.157, 0.176, 0.196, 1); gfx_rect(gbx, gby, 94, 42); );
  gfx_setfont(1, "Arial", 12, 98);
  gfx_set(gsel ? 1 : 0.78, gsel ? 1 : 0.78, gsel ? 1 : 0.80, 1);
  gfx_x = gbx + 10; gfx_y = gby + 14; gfx_drawstr(fxname[gt]);
  gt += 1;
);
gj = 0;
loop(4,
  gj < fxnp[rig_fx] ? (
    gkx = 520 + gj * 110; gky = 416;
    pr = 0.95; pg = 0.38; pb = 0.50;
    gv = rkv[rig_fx * 4 + gj];
    sprintf(#gs, "%d", floor(gv * 100 + 0.5));
    gfx_setfont(1, "Arial", 11);
    gfx_set(0.85, 0.85, 0.85, 1); gfx_measurestr(#gs, gw_, gh_); gfx_x = gkx - gw_ / 2; gfx_y = gky - 40; gfx_drawstr(#gs);
    gfx_set(0.62, 0.62, 0.66, 1); gfx_measurestr(fxn[rig_fx * 4 + gj], gw_, gh_); gfx_x = gkx - gw_ / 2; gfx_y = gky + 26; gfx_drawstr(fxn[rig_fx * 4 + gj]);
    drawknob(gkx, gky, gv, 0);
  );
  gj += 1;
);
gfx_setfont(1, "Arial", 11); gfx_set(0.5, 0.5, 0.52, 1);
gfx_x = 480; gfx_y = 458; gfx_drawstr("rig knob positions show what this window last sent; choosing a preset resets them to the middle");

// ====================== keyboard (A0 .. C8) ======================
gwk = 18.5; gkx = 19; gky = 484;
gn = 21;
loop(88,
  gpc = gn % 12;
  (gpc == 0 || gpc == 2 || gpc == 4 || gpc == 5 || gpc == 7 || gpc == 9 || gpc == 11) ? (
    gwi = floor(gn / 12) * 7 + (gpc >= 11 ? 6 : (gpc >= 9 ? 5 : (gpc >= 7 ? 4 : (gpc >= 5 ? 3 : (gpc >= 4 ? 2 : (gpc >= 2 ? 1 : 0)))))) - 12;
    keys[gn] > 0 ? gfx_set(1, 0.9 - 0.45 * keys[gn] / 127, 0.25, 1) : gfx_set(0.93, 0.93, 0.93, 1);
    gfx_rect(gkx + gwi * gwk, gky, gwk - 1, 110);
  );
  gn += 1;
);
gn = 21;
loop(88,
  gpc = gn % 12;
  (gpc == 1 || gpc == 3 || gpc == 6 || gpc == 8 || gpc == 10) ? (
    gm = gn - 1; gq = gm % 12;
    gwi = floor(gm / 12) * 7 + (gq >= 11 ? 6 : (gq >= 9 ? 5 : (gq >= 7 ? 4 : (gq >= 5 ? 3 : (gq >= 4 ? 2 : (gq >= 2 ? 1 : 0)))))) - 12;
    keys[gn] > 0 ? gfx_set(1, 0.75 - 0.4 * keys[gn] / 127, 0.15, 1) : gfx_set(0.08, 0.08, 0.08, 1);
    gfx_rect(gkx + (gwi + 1) * gwk - 6, gky, 11, 68);
  );
  gn += 1;
);
