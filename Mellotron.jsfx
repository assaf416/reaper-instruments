desc: Mellotron - Three Tape Mixer v1.0
// A vintage Mellotron emulation with three simultaneous tape selections
// Use with ReaSampler for authentic tape sample playback
// Features: Three independent tape selections, mixing controls, tape dynamics, wow/flutter

slider1:0<0,12,1>Tape 1 Selection
slider2:1<0,12,1>Tape 2 Selection
slider3:2<0,12,1>Tape 3 Selection
slider4:0.5<0,1,0.01>Tape 1 Level
slider5:0.5<0,1,0.01>Tape 2 Level
slider6:0.5<0,1,0.01>Tape 3 Level
slider7:0<-100,100,1>Pan 1
slider8:0<-100,100,1>Pan 2
slider9:0<-100,100,1>Pan 3
slider10:0.3<0,1,0.01>Tape Wow (Pitch Wobble)
slider11:0.4<0,1,0.01>Tape Saturation
slider12:1<0,2,0.01>Master Volume

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

@init
// Tape configurations: name and corresponding SF2 bank/preset
tapes = 13;
tape_names[0] = "MKII Flute";
tape_names[1] = "M400 Cello";
tape_names[2] = "MKII 3 Violins";
tape_names[3] = "Gc3 Brass";
tape_names[4] = "Gong";
tape_names[5] = "M300A Violins";
tape_names[6] = "M300B Violin";
tape_names[7] = "M400 Choir";
tape_names[8] = "M400 String Section";
tape_names[9] = "M400 Woodwind2";
tape_names[10] = "MKII Flute";
tape_names[11] = "MKII 3 Violins";
tape_names[12] = "MKII Brass";

// Initialize voice parameters
num_voices = 32;
loop(i = 0; i < num_voices; i += 1)
(
  voice_note[i] = -1;
  voice_velocity[i] = 0;
  voice_phase[i] = 0;
  voice_active[i] = 0;
  voice_amp[i] = 0;
  voice_tape[i] = 0;
);

poly_note = -1;
poly_velocity = 0;
poly_phase = 0;
poly_active = 0;

// UI state
ui_w = 800;
ui_h = 600;
gfx_ext_retina = 2;
ui_initialized = 0;

// Tape wobble LFO
wobble_phase = 0;

@slider
// Slider changes handled

@block
// MIDI processing
while(midirecv(offset, msg1, msg2, msg3))
(
  status = msg1 & 0xF0;
  channel = msg1 & 0x0F;

  status == 0x90 ? (
    // Note on
    note = msg2;
    velocity = msg3;

    // Find free voice
    free_voice = -1;
    loop(i = 0; i < num_voices; i += 1)
    (
      voice_active[i] == 0 ? (
        free_voice = i;
        break;
      );
    );

    free_voice >= 0 ? (
      voice_note[free_voice] = note;
      voice_velocity[free_voice] = velocity;
      voice_phase[free_voice] = 0;
      voice_active[free_voice] = 1;
      voice_tape[free_voice] = floor(rand(3)); // Random tape for variety
    );
  ) : status == 0x80 ? (
    // Note off
    note = msg2;
    loop(i = 0; i < num_voices; i += 1)
    (
      voice_note[i] == note ? voice_active[i] = 0;
    );
  );

  midisend(offset, msg1, msg2, msg3);
);

@sample
// Update wobble LFO
wobble_phase += 0.001 * slider10;
wobble_phase > 1 ? wobble_phase -= 1;

// Mix output
out_l = 0;
out_r = 0;

// Process each voice
loop(v = 0; v < num_voices; v += 1)
(
  voice_active[v] ? (
    note = voice_note[v];
    vel = voice_velocity[v] / 127;

    // Calculate note frequency
    freq = 440 * pow(2, (note - 69) / 12);

    // Apply tape wobble
    wobble = sin(wobble_phase * 2 * $pi) * 0.03; // 3% pitch variation
    freq_modulated = freq * (1 + wobble);

    // Simple oscillator for each tape (placeholder - in real version would load samples)
    amp = vel * 0.1 * (1 - voice_phase[v] / 44100);

    // Three tape mix
    tape1_level = slider4;
    tape2_level = slider5;
    tape3_level = slider6;

    // Pan values
    pan1 = slider7 / 100;
    pan2 = slider8 / 100;
    pan3 = slider9 / 100;

    // Simple waveform generation (sine wave for now)
    phase_inc = freq_modulated / srate;
    osc_out = sin(voice_phase[v] * 2 * $pi);

    // Add saturation from tape
    saturation = slider11;
    osc_out = tanh(osc_out * (1 + saturation * 2));

    // Distribute to tapes
    tape1_out = osc_out * tape1_level * amp;
    tape2_out = osc_out * tape2_level * amp;
    tape3_out = osc_out * tape3_level * amp;

    // Pan
    out_l += tape1_out * (1 - max(0, pan1)) + tape2_out * (1 - max(0, pan2)) + tape3_out * (1 - max(0, pan3));
    out_r += tape1_out * (1 + min(0, pan1)) + tape2_out * (1 + min(0, pan2)) + tape3_out * (1 + min(0, pan3));

    // Update phase
    voice_phase[v] += phase_inc;

    // End note after decay
    voice_phase[v] > 44100 * 2 ? voice_active[v] = 0;
  );
);

out_l *= slider12;
out_r *= slider12;

spl0 = out_l;
spl1 = out_r;

@gfx 1000 700
// UI Colors
bg_color = 0x1a1a1a;
tape_color = 0x3a3a3a;
title_color = 0xffffff;
label_color = 0xcccccc;
active_color = 0x4a9d6f;
tape_colors[0] = 0x1f8f00; // Green
tape_colors[1] = 0xff0000; // Red
tape_colors[2] = 0x0066ff; // Blue

gfx_clear = bg_color;

// TITLE
gfx_set(1, 1, 1, 1);
gfx_x = 30; gfx_y = 20;
gfx_setfont(0, "Arial", 32, 'b');
gfx_drawstr("MELLOTRON");
gfx_setfont(0, "Arial", 14);

gfx_set(0.7, 0.7, 0.7);
gfx_x = 30; gfx_y = 60;
gfx_drawstr("Three Tape Mixer - Vintage Keyboard Emulation");

// TAPE CHANNEL SECTION
tape_x = 30;
tape_y = 110;
tape_w = 280;
tape_h = 180;
tape_spacing = 30;

loop(t = 0; t < 3; t += 1)
(
  x = tape_x + (t * (tape_w + tape_spacing));
  y = tape_y;

  // Tape box background
  gfx_set(0.2, 0.2, 0.2);
  gfx_rect(x, y, tape_w, tape_h);
  gfx_set(0.4, 0.4, 0.4);
  gfx_rect(x, y, tape_w, tape_h, 0);

  // Tape color accent bar
  r = (tape_colors[t] & 0xff0000) >> 16;
  g = (tape_colors[t] & 0x00ff00) >> 8;
  b = (tape_colors[t] & 0x0000ff);
  gfx_set(r/255, g/255, b/255);
  gfx_rect(x, y, tape_w, 4);

  // Title
  gfx_set(1, 1, 1);
  gfx_x = x + 15; gfx_y = y + 10;
  gfx_drawstr("TAPE " .. (t + 1));

  // Tape selection display
  gfx_set(0.8, 0.8, 0.8);
  gfx_x = x + 15; gfx_y = y + 35;
  tape_idx = (t == 0) ? slider1 : ((t == 1) ? slider2 : slider3);
  gfx_drawstr(tape_names[tape_idx]);

  // Volume level
  gfx_set(0.5, 0.5, 0.5);
  gfx_x = x + 15; gfx_y = y + 60;
  gfx_drawstr("Level");

  level = (t == 0) ? slider4 : ((t == 1) ? slider5 : slider6);
  r = (tape_colors[t] & 0xff0000) >> 16;
  g = (tape_colors[t] & 0x00ff00) >> 8;
  b = (tape_colors[t] & 0x0000ff);
  gfx_set(r/255, g/255, b/255, 0.7);
  gfx_rect(x + 15, y + 75, level * 180, 15);

  gfx_set(0.3, 0.3, 0.3);
  gfx_rect(x + 15, y + 75, 180, 15, 0);

  // Level text
  gfx_set(1, 1, 1);
  gfx_x = x + 110; gfx_y = y + 77;
  level_pct = floor(level * 100);
  gfx_drawstr(level_pct .. "%");

  // Pan indicator
  gfx_set(0.5, 0.5, 0.5);
  gfx_x = x + 15; gfx_y = y + 100;
  gfx_drawstr("Pan");

  pan = (t == 0) ? slider7 : ((t == 1) ? slider8 : slider9);
  pan_normalized = (pan + 100) / 200; // Convert -100..100 to 0..1

  gfx_set(0.3, 0.3, 0.3);
  gfx_rect(x + 15, y + 115, 180, 8, 0);

  gfx_set(0.6, 0.6, 0.6);
  indicator_x = x + 15 + (pan_normalized * 180);
  gfx_rect(indicator_x - 2, y + 110, 4, 18);

  // VU meter (simple)
  gfx_set(0.5, 0.5, 0.5);
  gfx_x = x + 15; gfx_y = y + 140;
  gfx_drawstr("Activity");

  gfx_set(0.2, 0.5, 0.2);
  gfx_rect(x + 15, y + 155, level * 180 * 0.5, 10);
);

// EFFECTS SECTION
fx_x = 30;
fx_y = 320;
fx_w = 920;
fx_h = 140;

gfx_set(0.2, 0.2, 0.2);
gfx_rect(fx_x, fx_y, fx_w, fx_h);
gfx_set(0.4, 0.4, 0.4);
gfx_rect(fx_x, fx_y, fx_w, fx_h, 0);

gfx_set(0.8, 0.6, 0.3);
gfx_rect(fx_x, fx_y, fx_w, 4);

gfx_set(1, 1, 1);
gfx_x = fx_x + 15; gfx_y = fx_y + 10;
gfx_drawstr("TAPE CHARACTERISTICS");

// Wow slider
gfx_set(0.7, 0.7, 0.7);
gfx_x = fx_x + 15; gfx_y = fx_y + 35;
gfx_drawstr("Wow & Flutter");
gfx_x = fx_x + 350; gfx_y = fx_y + 35;
wow_pct = floor(slider10 * 100);
gfx_drawstr(wow_pct .. "%");

gfx_set(0.3, 0.3, 0.3);
gfx_rect(fx_x + 15, fx_y + 50, 300, 10, 0);
gfx_set(0.8, 0.6, 0.3);
gfx_rect(fx_x + 15, fx_y + 50, slider10 * 300, 10);

// Saturation slider
gfx_set(0.7, 0.7, 0.7);
gfx_x = fx_x + 15; gfx_y = fx_y + 75;
gfx_drawstr("Tape Saturation");
gfx_x = fx_x + 350; gfx_y = fx_y + 75;
sat_pct = floor(slider11 * 100);
gfx_drawstr(sat_pct .. "%");

gfx_set(0.3, 0.3, 0.3);
gfx_rect(fx_x + 15, fx_y + 90, 300, 10, 0);
gfx_set(0.8, 0.4, 0.2);
gfx_rect(fx_x + 15, fx_y + 90, slider11 * 300, 10);

// Master volume
gfx_set(0.7, 0.7, 0.7);
gfx_x = fx_x + 650; gfx_y = fx_y + 35;
gfx_drawstr("Master Volume");
gfx_x = fx_x + 900; gfx_y = fx_y + 35;
vol_pct = floor(slider12 * 100);
gfx_drawstr(vol_pct .. "%");

gfx_set(0.3, 0.3, 0.3);
gfx_rect(fx_x + 650, fx_y + 50, 220, 10, 0);
gfx_set(0.4, 0.8, 0.4);
gfx_rect(fx_x + 650, fx_y + 50, slider12 * 220, 10);

// INSTRUCTIONS SECTION
info_x = 30;
info_y = 480;

gfx_set(0.5, 0.5, 0.5);
gfx_x = info_x; gfx_y = info_y;
gfx_setfont(0, "Arial", 12);
gfx_drawstr("USAGE: Select different tapes on each channel and mix them together. Use Wow for vintage character and Saturation for tape warmth.");
