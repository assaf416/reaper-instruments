  v_ > 0 ? ( ex_chords(v_ - 1, #chords); cp_parse(#chords); cp_nsrc > 0 ? ui_setsl(3, min(16, cp_nsrc)); ui_setsl(1, 13); last_pre = 13; regen_req = 1; );
);
