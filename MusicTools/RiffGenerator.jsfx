(regen_req && !gen_busy) ? ( regen_req = 0; rg_generate(); );
gen_stop ? ( gen_stop = 0; );

// ---------------------------------------------------------------- piano roll + tab (one page = 4 bars)
npg_ = max(1, ceil(gen_L / 16));
page >= npg_ ? (page = npg_ - 1);
t0_ = page * 16;
ui_panel(20, 296, 960, 190, "RIFF  -  PIANO ROLL     guitar (amber)   bass (green)", 0.96, 0.62, 0.18);
draw_roll(30, 318, 940, 106, 0, t0_, 16, 0.96, 0.62, 0.18, 4);
draw_roll(30, 428, 940, 50, 1, t0_, 16, 0.36, 0.82, 0.5, 4);
// chord names + bar numbers
gfx_setfont(1, "Arial", 11, 98);
k_ = 0; loop(cs_n,
  (CS_BEAT[k_] >= t0_ - 0.01 && CS_BEAT[k_] < t0_ + 16) ? (
    chord_label(CS_ROOT[k_], CS_MASK[k_], #t_);
    gfx_x = 30 + (CS_BEAT[k_] - t0_) / 16 * 940 + 3; gfx_y = 319;
    gfx_set(1, 0.72, 0.25, 1); gfx_drawstr(#t_);
  );
  k_ += 1;
);
k_ = 0; loop(4,
  (t0_ + k_ * 4 < gen_L) ? ( sprintf(#t_, "bar %d", floor(t0_ / 4) + k_ + 1); gfx_set(0.5, 0.52, 0.56, 1); gfx_x = 30 + k_ * 235 + 3; gfx_y = 467; gfx_drawstr(#t_); );
  k_ += 1;
);
gfx_setfont(1, "Arial", 12);
ph_beat >= t0_ && ph_beat < t0_ + 16 ? ( gfx_set(0.95, 0.38, 0.5, 1); xph_ = 30 + (ph_beat - t0_) / 16 * 940; gfx_line(xph_, 318, xph_, 478, 1); gfx_line(xph_ + 1, 318, xph_ + 1, 478, 1); );

ui_panel(20, 494, 960, 178, "RIFF  -  TAB", 0.35, 0.6, 0.95);
gfx_set(0.62, 0.62, 0.66, 1); gfx_x = 100; gfx_y = 500; gfx_drawstr("GUITAR");  gfx_x = 160; gfx_drawstr("(standard tuning E A D G B E)    BASS (E A D G)");
draw_tab(30, 518, 940, 96, 6, 0, t0_, 16, 0.96, 0.62, 0.18);
draw_tab(30, 618, 940, 48, 4, 1, t0_, 16, 0.36, 0.82, 0.5);
ph_beat >= t0_ && ph_beat < t0_ + 16 ? ( gfx_set(0.95, 0.38, 0.5, 1); gfx_line(xph_, 518, xph_, 666, 1); );

// ---------------------------------------------------------------- footer: pages + status
ui_btn(20, 684, 34, 26, "<", 0, 0.5, 0.5, 0.5) ? ( page = max(0, page - 1); );
ui_btn(60, 684, 34, 26, ">", 0, 0.5, 0.5, 0.5) ? ( page = min(npg_ - 1, page + 1); );
gfx_set(0.7, 0.7, 0.72, 1);
sprintf(#t_, "bars %d-%d of %d     %d guitar notes, %d bass notes", page * 4 + 1, min(gen_L / 4, page * 4 + 4), gen_L / 4, 0, 0);
cg_ = 0; cb_ = 0; k_ = 0; loop(ev_n, EV_C[k_] == 0 ? (cg_ += 1) : (cb_ += 1); k_ += 1; );
sprintf(#t_, "bars %d-%d of %d     %d guitar notes, %d bass notes", page * 4 + 1, min(gen_L / 4, page * 4 + 4), gen_L / 4, cg_, cb_);
gfx_x = 108; gfx_y = 690; gfx_drawstr(#t_);
gfx_set(0.5, 0.52, 0.56, 1); sprintf(#t_, "MIDI notes sent: %d", pl_sent); gfx_x = 880; gfx_y = 690; gfx_drawstr(#t_);
gfx_set(0.7, 0.7, 0.72, 1);
cp_warn ? ( gfx_set(0.95, 0.5, 0.3, 1); gfx_x = 560; gfx_y = 690; gfx_drawstr("some chord names were not understood (played as major)"); ) :
(cp_nsrc == 0 ? ( gfx_set(0.6, 0.8, 0.95, 1); gfx_x = 560; gfx_y = 690; gfx_drawstr("no chords typed - progression built from key and mode"); ));
