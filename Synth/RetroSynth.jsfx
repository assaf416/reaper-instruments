pname[42] = "Cars";               pname[43] = "Don't Want Me Pad";  pname[44] = "Don't Want Me";   pname[45] = "Any Colour You Like";
pname[46] = "In the Cage";        pname[47] = "Abacab";            pname[48] = "Dudu";           pname[49] = "Lurker";

// ---- preset data: 36 values each ----
//   osc  (12): wave1 oct1 wave2 oct2 detune(cents) osc2level pulsewidth pwm sub noise unison spread
//   filt (15): cutoff reso envAmt keyTrk | ampA D S R | filtA D S R | lfoRate lfoPitch lfoFilter
//   play  (9): glide mono chorus delayMix delayTime delayFb reverb drive volume
//   waves: 0 saw 1 pulse 2 triangle 3 sine ;  times / cutoff / rate are 0..1 on exponential scales
