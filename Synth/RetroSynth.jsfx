// category boundaries for the UI: PADS 0-10, LEADS 11-17, BASS 18-23, KEYS & FX 24-33, ANALOG LEGENDS 34-49
cat0 = 0; cat1 = 11; cat2 = 18; cat3 = 24; cat4 = 34;

// control names
cname[0]="WAVE 1"; cname[1]="OCT 1"; cname[2]="WAVE 2"; cname[3]="OCT 2"; cname[4]="DETUNE"; cname[5]="OSC 2"; cname[6]="PULSE W";
cname[7]="PWM"; cname[8]="SUB"; cname[9]="NOISE"; cname[10]="UNISON"; cname[11]="SPREAD";
cname[12]="CUTOFF"; cname[13]="RESO"; cname[14]="ENV"; cname[15]="KEY";
cname[16]="A"; cname[17]="D"; cname[18]="S"; cname[19]="R"; cname[20]="A"; cname[21]="D"; cname[22]="S"; cname[23]="R";
cname[24]="RATE"; cname[25]="PITCH"; cname[26]="FILTER";
cname[27]="GLIDE"; cname[28]="MONO"; cname[29]="CHORUS"; cname[30]="DELAY"; cname[31]="TIME"; cname[32]="FDBK";
cname[33]="REVERB"; cname[34]="DRIVE"; cname[35]="VOLUME";

// ---- effect buffers ----
chlen = floor(0.04 * srate) + 4;
dlen = floor(1.1 * srate);
cbL = FXM; cbR = cbL + chlen; dbL = cbR + chlen; dbR = dbL + dlen;
memset(cbL, 0, chlen * 2);
memset(dbL, 0, dlen * 2);
cw = 0; dw = 0; cph = 0; dtc = 0.4 * srate; fbLf = 0; fbRf = 0;

// reverb (Freeverb layout)
ctun[0] = 1116; ctun[1] = 1188; ctun[2] = 1277; ctun[3] = 1356; ctun[4] = 1422; ctun[5] = 1491; ctun[6] = 1557; ctun[7] = 1617;
atun[0] = 556; atun[1] = 441; atun[2] = 341; atun[3] = 225;
rsc = srate / 44100;
rp = dbR + dlen;
rj = 0;
loop(16,
  clen[rj] = floor((ctun[rj % 8] + (rj >= 8 ? 23 : 0)) * rsc);
  cbase[rj] = rp; cidx[rj] = 0; cst[rj] = 0;
  memset(rp, 0, clen[rj]);
  rp += clen[rj]; rj += 1;
);
rj = 0;
loop(8,
  alen[rj] = floor((atun[rj % 4] + (rj >= 4 ? 23 : 0)) * rsc);
  abase[rj] = rp; aidx[rj] = 0;
  memset(rp, 0, alen[rj]);
  rp += alen[rj]; rj += 1;
);

// ---- state ----
i = 0; loop(NV, vact[i] = 0; vgate[i] = 0; vhold[i] = 0; vaL[i] = 0; vfL[i] = 0; i += 1; );
lastp = -1; ordc = 0; sustain = 0; bend = 0; modw = 0; lph = 0; lastpitch = 60; msn = 0; ctr = 0;
rr_ = 0; pkm = 0; gdrag = -1; glmd = 0;
nsrc = 1;

function blep(t, dt)
  local(x)
(
  t < dt ? ( x = t / dt; x + x - x * x - 1; ) :
  t > 1 - dt ? ( x = (t - 1) / dt; x * x + x + x + 1; ) : 0;
);

function osc(ph, dt, w, pw)
  local(v, q)
(
  w == 0 ? ( 2 * ph - 1 - blep(ph, dt); ) :
  w == 1 ? (
    q = ph - pw; q < 0 ? q += 1;
    (ph < pw ? 1 : -1) + blep(ph, dt) - blep(q, dt);
  ) :
  w == 2 ? ( 4 * abs(ph - 0.5) - 1; ) :
  sin(6.283185307 * ph);
);

function tanhx(x)
  local(y, e)
(
  y = max(-8, min(8, x));
  e = exp(2 * y);
  (e - 1) / (e + 1);
);

@block
// ---- preset change: copy the preset into the sliders ----
// first block after loading: if the faders were already changed (a saved project) keep them, otherwise load the preset
lastp < 0 ? (
  un_ = 1; i = 2;
  loop(36, abs(slider(i) - df[i]) > 0.0001 ? un_ = 0; i += 1; );
  !un_ ? lastp = slider1;
);
slider1 != lastp ? (
  lastp = slider1;
  pi_ = 0;
  loop(NPAR,
    slider(pi_ + 2) = PR[lastp * NPAR + pi_];
    sliderchange(2 ^ (pi_ + 1));
    pi_ += 1;
  );
);

// ---- derived parameters (once per block) ----
s_w1 = slider2; s_o1 = slider3; s_w2 = slider4; s_o2 = slider5; s_det2 = slider6; s_mix2 = slider7;
s_pw = slider8; s_pwm = slider9; s_sub = slider10; s_noi = slider11; s_uni = max(1, min(4, floor(slider12 + 0.5)));
s_udet = slider13 * 25;
s_cut = 20 * 900 ^ slider14; s_res = slider15 * 3.7; s_fenv = slider16; s_ktrk = slider17;
tA = 0.001 * 8000 ^ slider18; tD = 0.001 * 8000 ^ slider19; s_aS = slider20; tR = 0.001 * 8000 ^ slider21;
tfA = 0.001 * 8000 ^ slider22; tfD = 0.001 * 8000 ^ slider23; s_fS = slider24; tfR = 0.001 * 8000 ^ slider25;
a_inc = 1 / max(1, tA * srate);  a_dc = 1 - exp(-4 / (max(0.001, tD) * srate));  a_rc = exp(-4 / (max(0.001, tR) * srate));
f_inc = 1 / max(1, tfA * srate); f_dc = 1 - exp(-4 / (max(0.001, tfD) * srate)); f_rc = exp(-4 / (max(0.001, tfR) * srate));
l_rate = 0.1 * 120 ^ slider26;
s_lp = max(slider27, modw) * 0.7; s_lf = slider28;
s_gl = slider29; s_mono = slider30 > 0.5;
s_chor = slider31; s_dly = slider32; s_dtime = (0.06 + slider33 * 0.84) * srate; s_dfb = slider34;
s_rev = slider35 * 2.4; s_drive = slider36; s_vol = slider37 * 1.2;
// unison detune factors
u_ = 0;
loop(4,
  ufac[u_] = s_uni > 1 ? 2 ^ ((u_ / (s_uni - 1) * 2 - 1) * s_udet / 1200) : 1;
  u_ += 1;
);

while (midirecv(offs, m1, m2, m3)) (
  stt = m1 & 0xF0;
  (stt == 0x90 && m3 > 0) ? (
    // ---- note on ----
    s_mono ? (
      // keep a stack of held notes
      ms[msn] = m2; msn = min(15, msn + 1);
      (vact[0] && vgate[0]) ? (
        vtgt[0] = m2; vnote[0] = m2;                 // legato: glide to the new note, keep the envelopes running
      ) : (
        v = 0;
        vnote[v] = m2; vvel[v] = m3; vtgt[v] = m2; vpitch[v] = (s_gl > 0.001) ? lastpitch : m2;
        vaS[v] = 1; vaL[v] = 0; vfS[v] = 1; vfL[v] = 0; vgate[v] = 1; vhold[v] = 0; vact[v] = 1;
        vs1[v] = vs2[v] = vs3[v] = vs4[v] = 0;
        vord[v] = ordc; ordc += 1;
        k_ = 0; loop(4, vph1[v * 4 + k_] = s_uni > 1 ? rand(1) : 0; vph2[v * 4 + k_] = s_uni > 1 ? rand(1) : 0; k_ += 1; );
        vsub[v] = 0;
      );
    ) : (
      v = -1; i = 0; best = 1e12;
      while (i < NV && v < 0) ( vact[i] == 0 ? v = i; i += 1; );
      v < 0 ? ( i = 0; loop(NV, vord[i] < best ? ( best = vord[i]; v = i; ); i += 1; ); );
      vnote[v] = m2; vvel[v] = m3; vtgt[v] = m2; vpitch[v] = (s_gl > 0.001) ? lastpitch : m2;
      vaS[v] = 1; vaL[v] = 0; vfS[v] = 1; vfL[v] = 0; vgate[v] = 1; vhold[v] = 0; vact[v] = 1;
      vs1[v] = vs2[v] = vs3[v] = vs4[v] = 0;
      vord[v] = ordc; ordc += 1;
      k_ = 0; loop(4, vph1[v * 4 + k_] = s_uni > 1 ? rand(1) : 0; vph2[v * 4 + k_] = s_uni > 1 ? rand(1) : 0; k_ += 1; );
      vsub[v] = 0;
    );
    lastpitch = m2;
  ) : (stt == 0x80 || (stt == 0x90 && m3 == 0)) ? (
    // ---- note off ----
    s_mono ? (
      // remove from the stack
      i = 0; j = 0;
      loop(msn, ms[i] != m2 ? ( ms[j] = ms[i]; j += 1; ); i += 1; );
      msn = j;
      msn > 0 ? ( vtgt[0] = ms[msn - 1]; vnote[0] = ms[msn - 1]; ) : (
        sustain ? vhold[0] = 1 : ( vgate[0] = 0; vaS[0] = 4; vfS[0] = 4; );
      );
    ) : (
      i = 0;
      loop(NV,
        (vact[i] && vgate[i] && vnote[i] == m2) ? (
          sustain ? vhold[i] = 1 : ( vgate[i] = 0; vaS[i] = 4; vfS[i] = 4; );
        );
        i += 1;
      );
    );
  ) : (stt == 0xE0) ? (
    bend = ((m3 * 128 + m2) - 8192) / 8192 * 2;
  ) : (stt == 0xC0) ? (
    m2 < NP ? ( slider1 = m2; sliderchange(1); );
  ) : (stt == 0xB0) ? (
    m2 == 1 ? modw = m3 / 127 :
    m2 == 64 ? (
      sustain = (m3 >= 64);
      !sustain ? ( i = 0; loop(NV, vhold[i] ? ( vhold[i] = 0; vgate[i] = 0; vaS[i] = 4; vfS[i] = 4; ); i += 1; ); );
    ) :
    (m2 == 123 || m2 == 120) ? ( i = 0; loop(NV, vgate[i] = 0; vhold[i] = 0; vaS[i] = 4; vfS[i] = 4; i += 1; ); msn = 0; );
  );
);

@sample
// ---- LFO ----
lph += l_rate / srate; lph >= 1 ? lph -= 1;
lfo = sin(6.283185307 * lph);
pwe = max(0.05, min(0.95, s_pw + s_pwm * 0.4 * lfo));

// ---- control rate: pitch increments and filter coefficients every 16 samples ----
ctr -= 1;
ctr <= 0 ? (
  ctr = 16;
  gco = s_gl > 0.001 ? 1 - exp(-16 / (srate * (0.005 + s_gl * s_gl * 1.2))) : 1;
  i = 0;
  loop(NV,
    vact[i] ? (
      vpitch[i] += (vtgt[i] - vpitch[i]) * gco;
      sm = vpitch[i] + bend + lfo * s_lp;
      vdt1[i] = 440 * 2 ^ ((sm - 69) / 12 + s_o1) / srate;
      vdt2[i] = 440 * 2 ^ ((sm - 69) / 12 + s_o2 + s_det2 / 1200) / srate;
      fc = s_cut * 2 ^ (s_fenv * vfL[i] * 6 + s_ktrk * (vpitch[i] - 60) / 12 + s_lf * lfo * 2);
      fc = max(20, min(min(18000, 0.42 * srate), fc));
      vg[i] = min(0.75, 1 - exp(-6.283185307 * fc / srate));
    );
    i += 1;
  );
);

// ---- voices ----
mixo = 0;
i = 0;
loop(NV,
  vact[i] ? (
    // amp envelope
    sa = vaS[i]; la = vaL[i];
    sa == 1 ? ( la += a_inc; la >= 1 ? ( la = 1; sa = 2; ); ) :
    sa == 2 ? ( la += (s_aS - la) * a_dc; abs(la - s_aS) < 0.001 ? sa = 3; ) :
    sa == 3 ? la = s_aS :
    ( la *= a_rc; la < 0.0003 ? ( vact[i] = 0; la = 0; ); );
    vaS[i] = sa; vaL[i] = la;
    // filter envelope
    sf = vfS[i]; lf = vfL[i];
    sf == 1 ? ( lf += f_inc; lf >= 1 ? ( lf = 1; sf = 2; ); ) :
    sf == 2 ? ( lf += (s_fS - lf) * f_dc; abs(lf - s_fS) < 0.001 ? sf = 3; ) :
    sf == 3 ? lf = s_fS :
    lf *= f_rc;
    vfS[i] = sf; vfL[i] = lf;

    vact[i] ? (
      // oscillators (unison stack)
      o1 = 0; o2 = 0; u = 0;
      loop(s_uni,
        p1 = vph1[i * 4 + u] + vdt1[i] * ufac[u]; p1 >= 1 ? p1 -= 1; vph1[i * 4 + u] = p1;
        p2 = vph2[i * 4 + u] + vdt2[i] * ufac[u]; p2 >= 1 ? p2 -= 1; vph2[i * 4 + u] = p2;
        o1 += osc(p1, vdt1[i] * ufac[u], s_w1, pwe);
        o2 += osc(p2, vdt2[i] * ufac[u], s_w2, pwe);
        u += 1;
      );
      sx = (o1 + o2 * s_mix2) * (0.3 / sqrt(s_uni));
      sp = vsub[i] + vdt1[i] * 0.5; sp >= 1 ? sp -= 1; vsub[i] = sp;
      sx += sin(6.283185307 * sp) * s_sub * 0.4;
      sx += (rand(2) - 1) * s_noi * 0.4;

      // 4-pole resonant ladder filter
      x = sx - s_res * vs4[i];
      x = x / (1 + abs(x) * 0.6);
      g = vg[i];
      vs1[i] += g * (x - vs1[i]);
      vs2[i] += g * (vs1[i] - vs2[i]);
      vs3[i] += g * (vs2[i] - vs3[i]);
      vs4[i] += g * (vs3[i] - vs4[i]);
      mixo += vs4[i] * (1 + s_res * 0.25) * la * (0.4 + 0.6 * vvel[i] / 127);
    );
  );
  i += 1;
);

// ---- chorus (mono in, stereo out) ----
cph += 0.8 / srate; cph >= 1 ? cph -= 1;
cbL[cw] = mixo; cbR[cw] = mixo;
cbs = 0.012 * srate; cdp = 0.0045 * srate;
ct = cbs + cdp * sin(6.283185307 * cph);          crd = cw - ct; crd < 0 ? crd += chlen; c0 = floor(crd); cf = crd - c0; c1 = c0 + 1; c1 >= chlen ? c1 -= chlen;
cL1 = cbL[c0] + (cbL[c1] - cbL[c0]) * cf;
ct = cbs + cdp * sin(6.283185307 * (cph + 0.5));  crd = cw - ct; crd < 0 ? crd += chlen; c0 = floor(crd); cf = crd - c0; c1 = c0 + 1; c1 >= chlen ? c1 -= chlen;
cR1 = cbR[c0] + (cbR[c1] - cbR[c0]) * cf;
cw += 1; cw >= chlen ? cw = 0;
l = mixo * (1 - 0.4 * s_chor) + cL1 * s_chor * 0.8;
r = mixo * (1 - 0.4 * s_chor) + cR1 * s_chor * 0.8;

// ---- ping-pong delay ----
dtarget = max(8, min(dlen - 4, s_dtime));
dtc += (dtarget - dtc) * 0.0008;
drd = dw - dtc; drd < 0 ? drd += dlen;
d0 = floor(drd); df_ = drd - d0; d1 = d0 + 1; d1 >= dlen ? d1 -= dlen;
dL = dbL[d0] + (dbL[d1] - dbL[d0]) * df_;
dR = dbR[d0] + (dbR[d1] - dbR[d0]) * df_;
fbLf += (dL - fbLf) * 0.45; fbRf += (dR - fbRf) * 0.45;
dbL[dw] = (l + r) * 0.5 + fbRf * s_dfb;
dbR[dw] = fbLf * s_dfb;
dw += 1; dw >= dlen ? dw = 0;
l += dL * s_dly; r += dR * s_dly;

// ---- reverb ----
rin = (l + r) * 0.015;
rsl = 0; rsr = 0;
rj = 0;
loop(16,
  rb = cbase[rj]; rix = cidx[rj];
  ry = rb[rix];
  cst[rj] = ry * 0.6 + cst[rj] * 0.4;
  rb[rix] = rin + cst[rj] * 0.84;
  rix += 1; rix >= clen[rj] ? rix = 0;
  cidx[rj] = rix;
  rj < 8 ? rsl += ry : rsr += ry;
  rj += 1;
);
rj = 0;
loop(8,
  rb = abase[rj]; rix = aidx[rj];
  rbo = rb[rix];
  rj < 4 ? ( rb[rix] = rsl + rbo * 0.5; rsl = rbo - rsl; ) : ( rb[rix] = rsr + rbo * 0.5; rsr = rbo - rsr; );
  rix += 1; rix >= alen[rj] ? rix = 0;
  aidx[rj] = rix;
  rj += 1;
);
l += rsl * s_rev; r += rsr * s_rev;

// ---- drive + volume ----
dg = 1 + s_drive * 5;
outL = tanhx(l * dg) * s_vol / (1 + s_drive * 0.6);
outR = tanhx(r * dg) * s_vol / (1 + s_drive * 0.6);
spl0 = outL; spl1 = outR;
pkm = max(pkm * 0.9998, max(abs(outL), abs(outR)));

@gfx 900 670
gfx_clear = 0x1a1a1a;

// ====================== mouse ======================
gmd = mouse_cap & 1;
gmd && !glmd ? (
  gdrag = -1;
  // preset cells
  gp = 0;
  loop(NP,
    gc = gp < cat1 ? 0 : (gp < cat2 ? 1 : (gp < cat3 ? 2 : 3));
    gcs = gc == 0 ? cat0 : (gc == 1 ? cat1 : (gc == 2 ? cat2 : cat3));
    gx = 20 + gc * 220; gy = 78 + (gp - gcs) * 17;
    (mouse_x >= gx && mouse_x < gx + 208 && mouse_y >= gy && mouse_y < gy + 16) ? (
      slider1 = gp; sliderchange(1); slider_automate(1);
    );
    gp += 1;
  );
  // faders
  gi = 0;
  loop(NPAR,
    gx = 30 + (gi < 12 ? gi : (gi < 27 ? gi - 12 : gi - 27)) * 56;
    gy = gi < 12 ? 285 : (gi < 27 ? 407 : 529);
    (mouse_x >= gx - 6 && mouse_x < gx + 34 && mouse_y >= gy + 26 && mouse_y < gy + 98) ? (
      gdrag = gi;
      (mouse_cap & 4) ? (
        slider(gi + 2) = df[gi + 2];
        sliderchange(2 ^ (gi + 1)); slider_automate(2 ^ (gi + 1));
        gdrag = -1;
      );
    );
    gi += 1;
  );
);
gmd && gdrag >= 0 ? (
  gs = gdrag + 2;
  gy = gdrag < 12 ? 285 : (gdrag < 27 ? 407 : 529);
  gfrac = 1 - (mouse_y - (gy + 30)) / 64;
  gv = mn[gs] + (mx[gs] - mn[gs]) * max(0, min(1, gfrac));
  gv = floor(gv / st[gs] + 0.5) * st[gs];
  gv != slider(gs) ? (
    slider(gs) = gv;
    sliderchange(2 ^ (gs - 1)); slider_automate(2 ^ (gs - 1));
  );
);
!gmd ? gdrag = -1;
glmd = gmd;

// ====================== header ======================
gfx_setfont(1, "Arial", 28);
gfx_set(1, 1, 1, 1);
gfx_x = 20; gfx_y = 10;
gfx_drawstr("RETRO SYNTH");
gfx_setfont(1, "Arial", 14);
gfx_set(0.95, 0.65, 0.2, 1);
gfx_x = 250; gfx_y = 20;
gfx_drawstr(pname[slider1]);
gfx_set(0.6, 0.6, 0.6, 1);
gfx_x = 20; gfx_y = 46;
gfx_drawstr("Click a preset - drag a fader (Ctrl+click resets to the Init value)");
// output meter
gfx_set(0.1, 0.1, 0.1, 1); gfx_rect(700, 18, 180, 8);
gfx_set(0.9, 0.9, 0.3, 1); gfx_rect(700, 18, min(1, pkm * 1.2) * 180, 8);
gfx_set(0.45, 0.45, 0.45, 1); gfx_rect(700, 18, 180, 8, 0);

// ====================== preset browser ======================
gfx_set(0.2, 0.2, 0.2, 1); gfx_rect(12, 62, 876, 214);
gfx_set(0.4, 0.4, 0.4, 1); gfx_rect(12, 62, 876, 214, 0);
gc = 0;
loop(4,
  gx = 20 + gc * 220;
  gc == 0 ? ( gcr = 0.4; gcg = 0.65; gcb = 0.95; gnm = "PADS"; );
  gc == 1 ? ( gcr = 0.95; gcg = 0.6; gcb = 0.2; gnm = "LEADS"; );
  gc == 2 ? ( gcr = 0.9; gcg = 0.35; gcb = 0.35; gnm = "BASS"; );
  gc == 3 ? ( gcr = 0.45; gcg = 0.85; gcb = 0.55; gnm = "KEYS & FX"; );
  gfx_setfont(1, "Arial", 13);
  gfx_set(gcr, gcg, gcb, 1);
  gfx_x = gx; gfx_y = 64;
  gfx_drawstr(gnm);
  gfx_rect(gx, 77, 208, 1);
  gc += 1;
);
gp = 0;
loop(NP,
  gc = gp < cat1 ? 0 : (gp < cat2 ? 1 : (gp < cat3 ? 2 : 3));
  gcs = gc == 0 ? cat0 : (gc == 1 ? cat1 : (gc == 2 ? cat2 : cat3));
  gx = 20 + gc * 220; gy = 78 + (gp - gcs) * 17;
  gc == 0 ? ( gcr = 0.4; gcg = 0.65; gcb = 0.95; );
  gc == 1 ? ( gcr = 0.95; gcg = 0.6; gcb = 0.2; );
  gc == 2 ? ( gcr = 0.9; gcg = 0.35; gcb = 0.35; );
  gc == 3 ? ( gcr = 0.45; gcg = 0.85; gcb = 0.55; );
  ghov = (mouse_x >= gx && mouse_x < gx + 208 && mouse_y >= gy && mouse_y < gy + 16);
  (slider1 == gp) ? ( gfx_set(gcr * 0.55, gcg * 0.55, gcb * 0.55, 1); gfx_rect(gx, gy, 208, 16); ) :
  ghov ? ( gfx_set(0.3, 0.3, 0.3, 1); gfx_rect(gx, gy, 208, 16); );
  gfx_setfont(1, "Arial", 12);
  (slider1 == gp) ? gfx_set(1, 1, 1, 1) : gfx_set(0.82, 0.82, 0.82, 1);
  gfx_x = gx + 6; gfx_y = gy + 2;
  gfx_drawstr(pname[gp]);
  gp += 1;
);

// ====================== faders ======================
gfx_setfont(1, "Arial", 11);
// row panels
gr = 0;
loop(3,
  gy = gr == 0 ? 285 : (gr == 1 ? 407 : 529);
  gfx_set(0.2, 0.2, 0.2, 1); gfx_rect(12, gy - 6, 876, 118);
  gfx_set(0.4, 0.4, 0.4, 1); gfx_rect(12, gy - 6, 876, 118, 0);
  gr += 1;
);
gfx_set(0.95, 0.65, 0.2, 1);
gfx_x = 20; gfx_y = 281; gfx_drawstr("OSCILLATORS");
gfx_x = 20; gfx_y = 403; gfx_drawstr("FILTER");
gfx_x = 20 + 4 * 56; gfx_y = 403; gfx_drawstr("AMP ENV");
gfx_x = 20 + 8 * 56; gfx_y = 403; gfx_drawstr("FILTER ENV");
gfx_x = 20 + 12 * 56; gfx_y = 403; gfx_drawstr("LFO");
gfx_x = 20; gfx_y = 525; gfx_drawstr("PLAY  &  EFFECTS");

gi = 0;
loop(NPAR,
  gs = gi + 2;
  gx = 30 + (gi < 12 ? gi : (gi < 27 ? gi - 12 : gi - 27)) * 56;
  gy = gi < 12 ? 285 : (gi < 27 ? 407 : 529);
  gv = slider(gs);
  gfrac = (gv - mn[gs]) / (mx[gs] - mn[gs]);
  // name
  gfx_set(0.75, 0.75, 0.75, 1);
  gfx_x = gx + 14 - strlen(cname[gi]) * 2.8; gfx_y = gy + 12;
  gfx_drawstr(cname[gi]);
  // track + fill
  gfx_set(0.08, 0.08, 0.08, 1); gfx_rect(gx, gy + 30, 28, 64);
  gi < 12 ? gfx_set(0.95, 0.65, 0.2, 1) : (gi < 27 ? gfx_set(0.4, 0.65, 0.95, 1) : gfx_set(0.45, 0.85, 0.55, 1));
  gfx_rect(gx, gy + 30 + 64 * (1 - gfrac), 28, 64 * gfrac);
  gfx_set(0.95, 0.95, 0.95, 1); gfx_rect(gx - 2, gy + 30 + 64 * (1 - gfrac) - 1, 32, 3);
  gfx_set(0.45, 0.45, 0.45, 1); gfx_rect(gx, gy + 30, 28, 64, 0);
  // value text
  gfx_set(0.9, 0.9, 0.7, 1);
  (gi == 0 || gi == 2) ? ( gv == 0 ? sprintf(#gt, "SAW") : (gv == 1 ? sprintf(#gt, "PULSE") : (gv == 2 ? sprintf(#gt, "TRI") : sprintf(#gt, "SINE"))); ) :
  (gi == 1 || gi == 3) ? sprintf(#gt, "%+d", gv) :
  gi == 4 ? sprintf(#gt, "%+d c", gv) :
  gi == 10 ? sprintf(#gt, "%d", gv) :
  gi == 12 ? sprintf(#gt, "%d Hz", floor(20 * 900 ^ gv)) :
  (gi >= 16 && gi <= 19) || (gi >= 20 && gi <= 23) ? (
    (gi == 18 || gi == 22) ? sprintf(#gt, "%d%%", floor(gv * 100 + 0.5)) :
    ( gtm = 0.001 * 8000 ^ gv; gtm < 1 ? sprintf(#gt, "%d ms", floor(gtm * 1000 + 0.5)) : sprintf(#gt, "%.1f s", gtm); );
  ) :
  gi == 24 ? sprintf(#gt, "%.1f Hz", 0.1 * 120 ^ gv) :
  gi == 28 ? ( gv > 0.5 ? sprintf(#gt, "ON") : sprintf(#gt, "OFF"); ) :
  gi == 31 ? sprintf(#gt, "%d ms", floor(60 + gv * 840)) :
  gi == 32 ? sprintf(#gt, "%d%%", floor(gv / 0.9 * 100 + 0.5)) :
  sprintf(#gt, "%d%%", floor(gv * 100 + 0.5));
  gfx_x = gx + 14 - strlen(#gt) * 2.8; gfx_y = gy + 98;
  gfx_drawstr(#gt);
  gi += 1;
);
