pname[4]  = "Duran Pad";         pname[5]  = "Marillion Pad";    pname[6]  = "Jarre Sweep";      pname[7]  = "Oxygene Pad";
pname[8]  = "Warm Prophet";      pname[9]  = "Choir Pad";        pname[10] = "Glass Pad";
pname[11] = "Moore Lead";        pname[12] = "Genesis Solo";     pname[13] = "Marillion Lead";   pname[14] = "Jarre Lead";
pname[15] = "Prog Mono Lead";    pname[16] = "Duran Lead";       pname[17] = "Brass Lead";
pname[18] = "Duran Bass";        pname[19] = "Moog Bass";        pname[20] = "Sub Bass";         pname[21] = "Sequence Bass";
pname[22] = "Rubber Bass";       pname[23] = "Floyd Bass";
pname[24] = "Jupiter Brass";     pname[25] = "Poly Brass";       pname[26] = "String Machine";   pname[27] = "Pluck Arp";
pname[28] = "Bell Keys";         pname[29] = "Pulse Clav";       pname[30] = "Pulse Pluck";      pname[31] = "VCS3 Sweep";
pname[32] = "Wind FX";           pname[33] = "Init Saw";
